{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "navrang-relay-local-feasibility",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "NavrangRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NavrangRoom"] }]
}
